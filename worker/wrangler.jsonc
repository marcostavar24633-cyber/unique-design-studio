{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unique-design-studio-ai",
  "main": "index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  // Текстовые AI-запросы идут через Universal AI Gateway (Worker → Worker, без выхода в интернет).
  // Токен проекта — секрет GATEWAY_TOKEN. Без него студия вызывает Workers AI напрямую.
  "services": [
    { "binding": "GATEWAY", "service": "universal-ai-gateway" }
  ],
  "vars": {
    "AI_BILLING_MODE": "free",
    "NVIDIA_NIM_ENABLED": "false"
  }
}
