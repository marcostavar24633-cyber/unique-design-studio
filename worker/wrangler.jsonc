{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unique-design-studio-ai",
  "main": "index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_BILLING_MODE": "free",
    "NVIDIA_NIM_ENABLED": "false",
    "OPENROUTER_ENABLED": "false",
    "AI_PRIMARY_PROVIDER": "cloudflare",
    "AI_DIRECT_PROVIDERS_ENABLED": "false"
  }
}
