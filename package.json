{
  "name": "unique-design-studio",
  "version": "1.0.0",
  "description": "Генератор уникальных главных страниц: Design Brief → Design DNA → HTML с антишаблонной проверкой",
  "type": "module",
  "bin": {
    "uds": "bin/uds.js"
  },
  "exports": {
    ".": "./src/engine/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/uds.js serve",
    "build": "node scripts/build.mjs",
    "sync-core": "node scripts/sync-core.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:quick": "node scripts/run-e2e.mjs --quick",
    "install:e2e-browser": "node scripts/install-playwright-chromium.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
